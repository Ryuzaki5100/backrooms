{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noclip.local/schema/level.json",
  "title": "Level config",
  "$comment": "Validated by tools/Schema.luau at build time. Patterns are Lua patterns; keep them regex-compatible where possible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "source",
    "generate",
    "tileset",
    "transitions",
    "lighting"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        5
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^level-[a-z0-9][a-z0-9.-]*$",
      "maxLength": 48
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "dead_end": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note"
      ],
      "properties": {
        "note": {
          "type": "string",
          "pattern": "^60%-lore/"
        },
        "revid": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions",
        "tiles",
        "genMs",
        "loops"
      ],
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "tiles": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "genMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "loops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "deadEnds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "maxLevels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "connectorForms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "weight"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "hole",
                  "shaft"
                ]
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        },
        "corridors": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 0.6
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minShare",
                "maxShare"
              ],
              "properties": {
                "minShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.6
                },
                "maxShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.6
                }
              }
            }
          ]
        },
        "loopPreference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corridor_corridor"
          ],
          "properties": {
            "corridor_corridor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "corridor_hall": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "vertical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "room_room": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "connectivity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corridorBias"
          ],
          "properties": {
            "corridorBias": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "roomToRoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "extraChance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sealedShare": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }
          }
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        },
        "decoys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "share",
            "trapShare"
          ],
          "properties": {
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "trapShare": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "tileset": {
      "type": "string",
      "enum": [
        "lobby"
      ]
    },
    "transitions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gate",
          "outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "maxLength": 48
          },
          "gate": {
            "anyOf": [
              {
                "enum": [
                  "phase_wall",
                  "void_fall",
                  "entity_catch"
                ]
              },
              {
                "pattern": "^trigger:[a-z0-9][a-z0-9_]*$"
              },
              {
                "pattern": "^puzzle:[a-z0-9][a-z0-9_]*$"
              },
              {
                "pattern": "^(item|phenomenon|action|time):[a-z0-9][a-z0-9_]*$"
              }
            ]
          },
          "resolve": {
            "enum": [
              "seed",
              "run",
              "event"
            ]
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "level",
                    "weight"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "level"
                      ]
                    },
                    "level": {
                      "type": "string",
                      "pattern": "^level-[a-z0-9][a-z0-9.-]*$"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "node",
                    "weight"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "node"
                      ]
                    },
                    "node": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "predicate",
                    "weight"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "class"
                      ]
                    },
                    "predicate": {
                      "type": "string",
                      "pattern": "^(difficulty|tag|canon|level)([<>=!]+[a-z0-9._-]+)$"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "weight"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "void"
                      ]
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "weight"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "none"
                      ]
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "style": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$"
          }
        },
        "materials": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "props": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "weight",
          "anchor",
          "access"
        ],
        "properties": {
          "asset": {
            "anyOf": [
              {
                "pattern": "^rbxassetid://[0-9]+$"
              },
              {
                "pattern": "^procedural:[a-z0-9][a-z0-9_]*$"
              }
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "anchor": {
            "type": "string",
            "enum": [
              "floor",
              "wall",
              "ceiling",
              "volume"
            ]
          },
          "access": {
            "anyOf": [
              {
                "enum": [
                  "walk",
                  "sealed",
                  "noclip-only"
                ]
              },
              {
                "pattern": "^item:[a-z0-9][a-z0-9_]*$"
              }
            ]
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ambient",
              "area",
              "contact"
            ]
          },
          "gain": {
            "type": "number",
            "minimum": -60,
            "maximum": 0
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behaviour"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "behaviour": {
            "type": "string",
            "enum": [
              "ambient",
              "stalker",
              "patrol"
            ]
          },
          "density": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clockTime"
      ],
      "properties": {
        "clockTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "fogEnd": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "bloom": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "ambient": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$"
        }
      }
    },
    "seams": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "yaw": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          }
        }
      }
    }
  }
}
