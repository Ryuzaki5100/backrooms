          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parts": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ceiling": {
          "enum": [
            "slab",
            "none"
          ]
        },
        "maxLoadedParts": {
          "type": "integer",
          "minimum": 1
        },
        "enclosure": {
          "enum": [
            "none",
            "perimeter"
          ]
        }
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
