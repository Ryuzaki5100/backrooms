        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "where": {
            "type": "array",
            "items": {
              "enum": [
                "any_open",
                "open_hall",
                "near_wall",
                "dead_end"
              ]
            }
          },
          "minSpacing": {
            "type": "number",
            "minimum": 0
          },
          "densityCap": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "perChunk": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "footprint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "w": {
                "type": "integer",
                "minimum": 1
              },
              "d": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "prefab": {
