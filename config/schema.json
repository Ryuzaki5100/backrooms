        "unloadRadius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxChunksPerFrame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxChunksPerSecond": {
          "type": "number",
          "minimum": 0.1
